# Copy to .env and edit before running `docker compose up -d`.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=change_mgmt
POSTGRES_USER=change_mgmt
POSTGRES_PASSWORD=please-change-me
# For an externally managed database, set DATABASE_URL and leave
# POSTGRES_PASSWORD unset; the API validates the password in DATABASE_URL.
DATABASE_URL=

# --- API server ---------------------------------------------------------------
# Preferred session/JWT signing key. Generate 32 random bytes, for example:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
# New deployments should use an independent SESSION_SECRET. JWT_SECRET remains
# a compatibility name for existing installations during session migration.
SESSION_SECRET=replace-with-a-long-random-string
# Dedicated AES-GCM key for encrypted SMTP/LDAP/AD FS settings. Do not derive
# this from JWT_SECRET. Existing installations must carry forward their former
# JWT fallback key explicitly before rotating to an independent value.
APP_ENCRYPTION_KEY=replace-with-a-long-random-string
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Web server (Nginx + TLS) -------------------------------------------------
# Host ports the reverse proxy publishes.
HTTP_PORT=80
HTTPS_PORT=443

# Set DISABLE_TLS=true to serve HTTP only (NOT recommended for production).
DISABLE_TLS=false

# Hostname embedded into the auto-generated self-signed cert (only used when
# you have not provided your own cert in ./certs/server.crt + ./certs/server.key).
TLS_HOSTNAME=change-mgmt.local
TLS_SELFSIGNED_DAYS=365

# To use your own certificate, drop the files into ./certs/:
#   ./certs/server.crt
#   ./certs/server.key
# The web container will pick them up instead of generating a self-signed cert.
# Certificates can also be uploaded later through the in-app SSL settings page;
# the entrypoint will reuse whatever it finds in /etc/nginx/certs on next restart.

# --- Optional AD FS / OpenID Connect authentication ---------------------------
# Leave these empty until AD FS has been registered for this deployment.
# Stored Settings → AD FS values take precedence over these API fallbacks.
# Never commit a populated .env, client secret, or CA certificate.
ADFS_ENABLED=
ADFS_DISPLAY_NAME=
ADFS_ISSUER=
ADFS_DISCOVERY_URL=
ADFS_CLIENT_ID=
ADFS_CLIENT_SECRET=
ADFS_REDIRECT_URI=
ADFS_SCOPES=
ADFS_USERNAME_CLAIM=
ADFS_EMAIL_CLAIM=
ADFS_DISPLAY_NAME_CLAIM=
ADFS_CA_CERT_PEM=
